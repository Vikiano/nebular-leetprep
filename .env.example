# LeetPrep Studio - environment variables
# Copy to .env.local for development. Set the same values in Vercel Project Settings for production.

# Supabase (public, exposed to client)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# Supabase (server-only - service role key)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Anthropic (server-only)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY

# OpenAI (server-only, optional fallback)
OPENAI_API_KEY=YOUR_OPENAI_KEY

# Resend (optional transactional email)
RESEND_API_KEY=

# Upstash Redis (optional rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Site URL (used in metadata)
NEXT_PUBLIC_SITE_URL=https://leetprep.nebular.art
